process {
  executor = 'awsbatch'

  withName: GATK4_BASERECALIBRATOR {
    queue = "${PW_ONDEMAND_JOB_QUEUE}"
    errorStrategy = 'terminate'
    maxRetries = 3
    cpus = 2
    memory = { 16.GB * task.attempt }
  }
  withName: GATK4_APPLYBQSR {
    queue = "${PW_ONDEMAND_JOB_QUEUE}"
    errorStrategy = 'terminate'
    maxRetries = 3
    cpus = 2
    memory = { 16.GB * task.attempt }
  }
}

aws {
  region = 'us-east-1'
}